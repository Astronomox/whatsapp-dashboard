# ===========================================
# WhatsApp Dashboard - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server
PORT=5000
NODE_ENV=development

# MongoDB (get a free cluster at https://mongodb.com/atlas)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/whatsapp-dashboard?retryWrites=true&w=majority

# JWT Auth (use any random string for the secret)
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=7d

# Meta WhatsApp Business API
# Get these from: https://developers.facebook.com/apps → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any_random_string_you_choose

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
